{
    "name": "couryo/couryo-php",
    "description": "Official PHP SDK for the Couryo email API: retries, automatic Idempotency-Key, webhook verification and a Laravel mail transport.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "couryo",
        "email",
        "transactional email",
        "smtp",
        "webhooks",
        "laravel",
        "symfony mailer"
    ],
    "homepage": "https://couryo.com",
    "support": {
        "docs": "https://couryo.com/docs/sdks",
        "source": "https://github.com/Wunka-Tech/couryo-php",
        "issues": "https://github.com/Wunka-Tech/couryo-php/issues"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "illuminate/config": "^10.0 || ^11.0 || ^12.0",
        "illuminate/container": "^10.0 || ^11.0 || ^12.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "symfony/mailer": "^6.2 || ^7.0",
        "symfony/mime": "^6.2 || ^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "suggest": {
        "laravel/framework": "To send Laravel mail through Couryo with MAIL_MAILER=couryo (the service provider is auto-discovered)",
        "symfony/mailer": "To use Couryo\\Laravel\\CouryoTransport as a Symfony Mailer transport (^6.2 or ^7.0)",
        "psr/http-client": "To use Couryo\\Http\\Psr18Transport with any PSR-18 HTTP client instead of curl",
        "psr/http-factory": "Request and stream factories for Couryo\\Http\\Psr18Transport"
    },
    "autoload": {
        "psr-4": {
            "Couryo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Couryo\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Couryo\\Laravel\\CouryoServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
